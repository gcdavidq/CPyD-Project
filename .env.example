# =============================================================================
#  Configuracion del Sistema de Votacion Distribuida
#
#  Copia este fichero a `.env` y ajusta lo que necesites:
#      cp .env.example .env
#
#  Nada de esto esta hardcodeado en el codigo: todos los valores tienen un
#  defecto razonable, asi que el sistema arranca sin .env.
# =============================================================================

# ---------------------------------------------------------------------------
#  Cluster MPI (lo leen los binarios C++)
# ---------------------------------------------------------------------------

# Prefijo de los CSV de votos. El nodo de rank N lee "<prefijo>N.csv", de modo
# que el rank 1 procesa DATA/votos_region1.csv, el rank 2 el region2, etc.
VOTACION_DATA_PREFIX=DATA/votos_region

# Dashboard al que el nodo maestro publica las estadisticas por HTTP.
VOTACION_DASHBOARD_URL=http://localhost:5000

# Hilos OpenMP por nodo. Un buen punto de partida es el numero de nucleos
# fisicos dividido entre los procesos MPI que corran en esa misma maquina.
VOTACION_NUM_HILOS=4

# Hilos que dedica en concreto el algoritmo de deteccion de anomalias.
VOTACION_HILOS_ALGORITMO=2

# Votos por lote. Lotes grandes = menos overhead de MPI pero peor granularidad
# para el balanceo de carga.
VOTACION_TAM_LOTE=60000

# Cada cuantos segundos el maestro publica estadisticas globales.
VOTACION_INTERVALO_REPORTE_SEG=60

# Cada cuantos segundos el maestro comprueba si hay que rebalancear.
VOTACION_INTERVALO_BALANCEO_SEG=15

# Segundos sin actividad tras los que el maestro da la ejecucion por terminada.
VOTACION_TIMEOUT_FIN_SEG=30

# 1 = traza detallada. Util para depurar, pero penaliza el rendimiento y por
# tanto falsea las mediciones de speedup. Dejalo a 0 para hacer benchmarks.
VOTACION_VERBOSE=0


# ---------------------------------------------------------------------------
#  Dashboard web (lo lee DASHBOARD_VOTACION/app.py)
# ---------------------------------------------------------------------------

# live   = espera datos reales del cluster MPI
# replay = reproduce en bucle una ejecucion grabada (modo de la demo publica)
MODO_DASHBOARD=live

# 1 = guarda en FICHERO_DEMO todo lo que llegue, para poder reproducirlo luego.
GRABAR_EJECUCION=0

# Ruta de la grabacion, relativa a DASHBOARD_VOTACION/.
FICHERO_DEMO=demo/ejecucion_real.jsonl

# Velocidad de reproduccion (2.0 = el doble de rapido que la ejecucion real).
REPLAY_VELOCIDAD=1.0

# Segundos de pausa entre repeticiones del bucle de replay.
REPLAY_PAUSA_SEG=4

# Puerto del servidor web.
PORT=5000

# NUNCA actives el modo debug en un servidor publico: permite ejecutar codigo
# arbitrario a traves del depurador de Werkzeug.
FLASK_DEBUG=0

# Clave de sesion de Flask. En produccion pon aqui un valor aleatorio y secreto:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-en-produccion
