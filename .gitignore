# cifras del README y ocupan unos pocos KB.
!benchmarks/resultados/*.csv

# ---- Artefactos de compilacion C++ ----
build/
cmake-build-*/
*.o
*.obj
*.a
*.so
*.dylib
*.exe
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
